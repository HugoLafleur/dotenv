#!/bin/bash

# check if logged in
# if [ -z ~/.onepassword/token ]
# then
#    op item list > /dev/null 2>&1 || eval $(op signin --account my)
# else
#    export $(cat ~/.onepassword/token) && op item list > /dev/null 2>&1 || eval $(op signin --account my)
# fi
# env | grep OP_SESSION > ~/.onepassword/token

#
DC_TOKEN="$(op item get 'ServiceNow OpenLDAP' --otp )"
LDAP_PWD="$(op item get 'ServiceNow OpenLDAP' --field password)"

USERPASS="hugo.lafleur:"$LDAP_PWD$DC_TOKEN
USERPASS_B64=$(echo -n $USERPASS | base64)

DC_QUERY='operational_status=1^x_snc_k8s_cmdb_ext_lifecycle=ready'

curl --silent -XGET \
   --header "Authorization: Basic $USERPASS_B64"  \
   --header "Accept: application/json" \
   "https://datacenter.service-now.com/api/now/table/cmdb_ci_kubernetes_cluster?sysparm_query=$DC_QUERY" 
